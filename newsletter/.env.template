# ──────────────────────────────────────────────────
# FengOffice Newsletter — 环境变量模板
# 复制为 .env 后填写真实值 (.env 已 gitignored)
# ──────────────────────────────────────────────────

# === Listmonk 管理员 ===
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=  # ← 改一个强密码

# === 数据库 (开发环境用默认即可) ===
# LISTMONK_DB_USER=listmonk
# LISTMONK_DB_PASSWORD=listmonk

# === Resend (发信通道) ===
# 注册: https://resend.com → Add Domain → 验证 news.fengyuwang.com
RESEND_API_KEY=re_xxx_xxxxx  # ← 替换为你的 Resend API Key

# === 发件人地址 ===
NEWSLETTER_FROM_EMAIL=fengyu@news.fengyuwang.com

# === Listmonk API (脚本使用) ===
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USERNAME=admin
LISTMONK_API_PASSWORD=  # ← 同上管理员密码
